  "name": "Thumbnail Director AI - Main Orchestrator",
  "nodes": [
    {
      "parameters": {
        "formTitle": "🎬 Thumbnail Director AI | مخرج الصور المصغرة بالذكاء الاصطناعي",
        "formDescription": "الصق سكربت فيديو اليوتيوب الخاص بك أدناه، وسيقوم الذكاء الاصطناعي بتحليله كمخرج إبداعي وتوليد 10 أفكار احترافية لصورة مصغرة عالية النقر مع أوامر جاهزة لنماذج توليد الصور.\n\nPaste your YouTube video script below and the AI will analyze it like a Creative Director and generate 10 professional high-CTR thumbnail concepts with production-ready image-generation prompts.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "سكربت الفيديو | YouTube Script",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
